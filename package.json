{
  "name": "e2e-col",
  "version": "0.0.1",
  "private": true,
  "description": "Modern E2EE collaborative-document implementation inspired by SignalCD.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @e2e-col/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:core": "vitest run packages/core packages/protocol packages/transport packages/testing",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:storage": "vitest run packages/storage",
    "test:sidecar": "vitest run apps/sidecar",
    "test:toy-signal-cli": "vitest run apps/toy-signal-cli",
    "demo:signal": "pnpm --filter @e2e-col/toy-signal-cli dev",
    "version:check": "node scripts/check-version.js",
    "check": "pnpm run version:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "check:release": "pnpm run check && pnpm run test:e2e"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
